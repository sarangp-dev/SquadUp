{
  "expo": {
    "name": "SquadUp",
    "slug": "MyFirstApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/SquadUpIcon.png",
    "scheme": "SquadUp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/SquadUp.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#208AEF",
        "foregroundImage": "./assets/images/SquadUpIcon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sarang_1p.SquadUp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/SquadUp.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/SquadUp.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a400b615-259a-4240-b9c1-a686c24a26f3"
      }
    }
  }
}